{
  "name": "costku-backend",
  "version": "1.0.0",
  "description": "Backend API service for costKu",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test:otp": "tsx --test test/otp.crypto.test.ts test/otp.service.test.ts",
    "test:nlp": "tsx --test test/nlp.*.test.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "finance",
    "ledger",
    "costku",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "midtrans-client": "^1.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "nodemailer": "^10.0.10",
    "redis": "^6.2.1"
  }
}
