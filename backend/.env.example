PORT=5000
NODE_ENV=development

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://fzsbruymfwvcaallosrv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Or use SUPABASE_ANON_KEY if service role is not yet available
SUPABASE_ANON_KEY=your_supabase_anon_key

# ─────────────────────────────────────────────────────────
# Google OAuth (server-side Authorization Code flow)
# ─────────────────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application).
#
# Authorized JavaScript origins:
#   http://localhost:5173
# Authorized redirect URIs:
#   http://localhost:5000/api/v1/auth/google/callback
#
# The redirect URI must match GOOGLE_REDIRECT_URI below byte-for-byte
# (scheme, host, port, path, no trailing slash), otherwise Google answers
# with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# NEVER prefix this with VITE_ and never commit it. Vite inlines every
# VITE_* value into the shipped browser bundle, which would let any visitor
# read the secret and impersonate your app.
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Where the browser lands once the OAuth callback finishes.
FRONTEND_URL=http://localhost:5173

# Optional HMAC key for the OAuth `state` parameter. Falls back to OTP_PEPPER.
OAUTH_STATE_SECRET=

# ─────────────────────────────────────────────────────────
# Midtrans Payment Gateway (Sandbox for Development)
# Get keys from: https://dashboard.sandbox.midtrans.com/settings/access_keys
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# ─────────────────────────────────────────────────────────
# OTP Verification (see otpplan.md §6)
# ─────────────────────────────────────────────────────────

# Code shape and lifetime
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# Verification attempts per OTP, then the code is burned
OTP_MAX_ATTEMPTS=5

# Minimum gap between resends, in seconds
OTP_RESEND_COOLDOWN_SECONDS=60

# Hourly request caps
OTP_MAX_REQUESTS_PER_HOUR_DEST=5
OTP_MAX_REQUESTS_PER_HOUR_IP=10

# REQUIRED IN PRODUCTION: HMAC pepper for hashing OTP codes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value — load it from your secret manager.
OTP_PEPPER=

# Delivery channel: EMAIL | SMS | WHATSAPP
# SMS and WHATSAPP currently fall back to console delivery (interface is ready).
OTP_CHANNEL=EMAIL

# Dev/test only — a fixed code so the flow is deterministic locally.
# IGNORED when NODE_ENV=production. Leave empty to use a real CSPRNG code.
OTP_DEV_FIXED_CODE=

# Delete accounts that never verified, in days
UNVERIFIED_USER_TTL_DAYS=3

# Delivery retry policy
OTP_SEND_RETRY_ATTEMPTS=3
OTP_SEND_RETRY_BASE_DELAY_MS=1500

# SMTP for the email channel (Gmail / Mailtrap / Resend SMTP / etc.)
# Without these the backend logs the OTP to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OTP_EMAIL_FROM=no-reply@costku.id
OTP_EMAIL_FROM_NAME=costKu

# Optional. When set, rate limits and cooldowns are shared via Redis.
# When empty, an in-process limiter is used (fine for a single instance).
REDIS_URL=

