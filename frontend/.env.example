# ─────────────────────────────────────────────────────────
# costKu Frontend Environment Variables
# ─────────────────────────────────────────────────────────

# Supabase Credentials (Public Anon Key & URL)
# Diambil dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API Service URL
# Lokal: http://localhost:5000
# Produksi (Railway): https://costku-backend-production.up.railway.app
# JANGAN sertakan trailing slash (/) di akhir URL
VITE_BACKEND_URL=http://localhost:5000
