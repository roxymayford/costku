# ─────────────────────────────────────────────────────────
# costKu Frontend Environment Variables
# ─────────────────────────────────────────────────────────

# Supabase Credentials (Public Anon Key & URL)
# Diambil dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API Service URL
# Lokal: http://localhost:5000
# Produksi (Railway): https://costku-backend.up.railway.app
#   -> ini domain FINAL backend costKu. Jangan tertukar dengan
#      `costku-production` / `costku-backend-production` — keduanya sudah mati.
# JANGAN sertakan trailing slash (/) di akhir URL
# CATATAN: nilai ini "dibakar" ke bundle saat build. Kalau dikosongkan, bundle
# Vercel akan memanggil localhost:5000 dari browser pengunjung dan request gagal.
VITE_BACKEND_URL=http://localhost:5000
