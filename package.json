    "nanoid": "^3.3.19",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "^1.2.8",
    "scheduler": "^0.28.0",
